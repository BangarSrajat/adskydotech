RewriteEngine On

# 1. blog/ ke andar aayi assets/uploads ki request ko asli folder par bhejo (CSS, JS, logo, images)
RewriteRule ^blog/(assets|uploads)/(.*)$ $1/$2 [L]

# 2. UPDATED: Blog post - Ab yeh dummy-contet (bina number) aur text-82 (with number) dono ko accept karega
RewriteRule ^blog/([a-zA-Z0-9-]+)/?$ blog-single.php?slug=$1 [L,QSA]

# example.com/about ko example.com/about.php se serve karega
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# Agar koi directly .php type kare to redirect kar do clean URL pe
RewriteCond %{THE_REQUEST} /([^.]+)\.php[\s?] [NC]
RewriteRule ^ /%1 [NC,L,R=301]
